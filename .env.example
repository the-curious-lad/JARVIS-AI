# ==========================================
# JARVIS AI — Environment Configuration
# ==========================================

# 1. Database (MongoDB Atlas)
# Leave empty to automatically use the safe in-memory/file-backed persistent fallback for local dev/testing
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jarvis?retryWrites=true&w=majority
MONGODB_DB_NAME=jarvis

# 2. Open-Weight Model: Gemma
# Provider options: "groq", "huggingface", "google", "ollama", "mock"
GEMMA_PROVIDER=mock
GEMMA_MODEL=gemma-2-9b-it
# Provide your API key according to provider:
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# 3. Web Research: SerpApi
# Leave empty to use the realistic offline research fixture fallback
SERPAPI_API_KEY=

# 4. Voice: ElevenLabs
# Leave empty to use Web Speech API fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# 5. Observability: Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 6. Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
